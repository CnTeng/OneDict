{
  "name": "onedict",
  "version": "0.2.0",
  "private": true,
  "description": "Look up words, explain text with AI, and add cards to Anki.",
  "author": "CnTeng",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "build:zotero": "tsx scripts/build.ts zotero",
    "build": "run-p -sl build:*",
    "package:chrome": "tsx scripts/build.ts chrome --package",
    "package:firefox": "tsx scripts/build.ts firefox --package",
    "package:zotero": "tsx scripts/build.ts zotero --package",
    "package": "npm run clean && run-p -sl package:*"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "cn": "^0.4.0",
    "i18next": "^26.4.4",
    "ky": "^2.2.0",
    "lucide-preact": "^1.55.0",
    "openai": "^7.32.0",
    "preact": "11.0.1",
    "sentencex-ts": "^0.1.13-ts",
    "webdav": "^5.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "adm-zip": "^0.6.1",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zotero-types": "^4.1.3"
  },
  "allowScripts": {
    "esbuild": true,
    "es5-ext": true
  }
}
